SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_NAME=finance_manager_dev
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/finance_manager_dev
DB_USERNAME=postgres
DB_PASSWORD=change_me_locally

FINANCE_MANAGER_TEST_DB_URL=jdbc:postgresql://localhost:5432/finance_manager_test
FINANCE_MANAGER_TEST_DB_USERNAME=finance_manager_test
FINANCE_MANAGER_TEST_DB_PASSWORD=finance_manager_test

JWT_ISSUER=finance-manager-api
JWT_EXPIRATION_SECONDS=3600
JWT_SECRET=your_jwt_secret_key_here

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Sugestões de transação (opcional). Use google-genai para habilitar.
TRANSACTION_SUGGESTION_PROVIDER=none
GEMINI_API_KEY=

# Histórico de categorias no chat. Informe UUIDs separados por vírgula.
TRANSACTION_CHAT_RAG_ENABLED=false
TRANSACTION_CHAT_RAG_PILOT_USER_IDS=
TRANSACTION_CHAT_RAG_SEARCH_TIMEOUT=2s
TRANSACTION_CHAT_RAG_MIN_SIMILARITY=0.55
TRANSACTION_CHAT_RAG_LOG_LEVEL=INFO

# Prod
FINANCE_MANAGER_DB_URL=jdbc:postgresql://<POOLED_HOST>/finance_manager_prod?sslmode=require
FINANCE_MANAGER_DB_USERNAME=finance_manager_app
FINANCE_MANAGER_DB_PASSWORD=change_me_in_production

FINANCE_MANAGER_FLYWAY_URL=jdbc:postgresql://<DIRECT_HOST>/finance_manager_prod?sslmode=require
FINANCE_MANAGER_FLYWAY_USERNAME=finance_manager_migrator
FINANCE_MANAGER_FLYWAY_PASSWORD=change_me_in_production
